# === Veritabanı (Neon free tier — postgresql+asyncpg prefix'i ile) ===
# Neon konsolundan "Direct connection" alın, başına postgresql+asyncpg:// ekleyin
DATABASE_URL=postgresql+asyncpg://...

# === Groq LLM (cloud için ZORUNLU) ===
# https://console.groq.com/keys adresinden alınır
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# === Embeddings ===
# "cloudflare": Cloudflare Workers AI (ücretsiz 10k neuron/gün, cloud'da kullanılır)
# "local": sentence-transformers (lokal geliştirme, torch gerektirir)
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5

# === Lokal geliştirme (opsiyonel) ===
# Ollama ile lokal test: OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_BASE_URL=

# === Auth (JWT) — Prod'da mutlaka değiştirin ===
JWT_SECRET=changeme
JWT_ALG=HS256
JWT_EXPIRE_MIN=1440

# === CORS (Vercel frontend) ===
CORS_ORIGINS=["https://mizan.vercel.app"]
